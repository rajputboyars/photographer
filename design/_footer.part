    <div style="padding: 0 44px 40px;">
      <div class="glass" style="padding: 44px 40px 30px;">
        <div style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px; padding-bottom: 34px;">
          <div style="grid-column: span 5; display: flex; flex-direction: column; gap: 14px;">
            <span style="font-size: 22px; font-weight: 500;">Isha Photography</span>
            <p style="font-size: 15px; line-height: 1.8; color: rgba(244,246,251,0.7); max-width: 330px;">Wedding photography and cinema in [YOUR CITY], travelling anywhere you&rsquo;ll have us.</p>
          </div>
          <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 12px; font-size: 15px; color: rgba(244,246,251,0.78);">
            <span class="meta" style="margin-bottom: 4px;">Pages</span>
            <span>Portfolio</span><span>Collections</span><span>Studio</span><span>Contact</span>
          </div>
          <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 12px; font-size: 15px; color: rgba(244,246,251,0.78);">
            <span class="meta" style="margin-bottom: 4px;">Follow</span>
            <span>Instagram</span><span>Facebook</span><span>YouTube</span>
          </div>
          <div style="grid-column: span 3; display: flex; flex-direction: column; gap: 12px; font-size: 15px; color: rgba(244,246,251,0.78);">
            <span class="meta" style="margin-bottom: 4px;">Get in touch</span>
            <span>[hello@yourdomain.com]</span><span>[+91 00000 00000]</span><span>[Studio address, City]</span>
          </div>
        </div>
        <div style="height: 1px; background: rgba(255,255,255,0.16);"></div>
        <div style="display: flex; justify-content: space-between; padding-top: 22px; font-size: 13px; color: rgba(244,246,251,0.55);">
          <span>&copy; [YEAR] Isha Photography</span><span>Privacy &middot; Terms</span>
        </div>
      </div>
